{
  "_meta": {
    "version": "1.0",
    "description": "FAIRA Risk Assessment Scoring Configuration",
    "formula": "Raw Risk Score = (Total Impact \u00d7 Total Likelihood) / Control Effectiveness",
    "special_modifiers": {
      "AutonomyFactor": "Computed from A1.6 (autonomy level)",
      "DataQualityFactor": "Computed from A2.5 (data quality ratings)",
      "ExpertiseFactor": "Computed from A3.2 (user expertise levels)"
    }
  },
  "questions": {
    "A1_1": {
      "id": "A1_1",
      "text": "What is the primary function of the AI system?",
      "type": "multiselect",
      "domains": [
        "Accountability",
        "Transparency"
      ],
      "scoring": {
        "target_metric": "Impact",
        "options": {
          "Automate routine tasks": {
            "Impact": 1
          },
          "Support human decision-making": {
            "Impact": 2
          },
          "Make autonomous decisions": {
            "Impact": 3
          },
          "Predict outcomes": {
            "Impact": 2
          },
          "Generate content": {
            "Impact": 1
          },
          "Classify or categorize data": {
            "Impact": 1
          },
          "Detect anomalies or patterns": {
            "Impact": 2
          },
          "Other": {
            "Impact": 1
          }
        }
      }
    },
