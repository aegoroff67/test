  "images": {
    "risk_gauge_image": {
      "type": "InlineImage",
      "description": "Risk score gauge/stacked column visualization"
    },
    "domain_radar_impact": {
      "type": "InlineImage",
      "description": "Radar chart - Domain Impact scores"
    },
    "domain_radar_likelihood": {
      "type": "InlineImage",
      "description": "Radar chart - Domain Likelihood scores"
    },
    "domain_radar_ce": {
      "type": "InlineImage",
      "description": "Radar chart - Domain Control Effectiveness"
    },
    "domain_radar_risk": {
      "type": "InlineImage",
      "description": "Radar chart - Residual Domain Risk scores"
    },
    "inherent_risk_radar": {
      "type": "InlineImage",
      "description": "Radar chart - Inherent Domain Risk (before controls)"
    }
  },
  "ai_narratives": {
    "_description": "AI-generated narrative content (when use_ai=true). Access via ai.VARIABLE_NAME",
    "f_executive_snapshot": "Executive summary of FAIRA assessment findings",
    "f_risk_profile_interpretation": "Interpretation of overall risk profile and scoring",
    "f_domain_analysis": "Analysis of domain-level risks and patterns",
    "f_control_recommendations": "Narrative about recommended controls and prioritization",
    "f_next_steps": "Recommended next steps and implementation guidance"
  },
  "template_syntax_examples": {
    "simple_variable": "{{org_name}}",
    "nested_object": "{{domain_scores.Accountability.Risk}}",
    "loop_over_array": "{% for control in recommended_controls %}\n  {{control.title}} - {{control.priority}}\n{% endfor %}",
    "conditional": "{% if overall_risk_level == 'High' %}ATTENTION REQUIRED{% endif %}",
    "image_placeholder": "{{risk_gauge_image}}",
    "ai_narrative": "{{ai.f_executive_snapshot}}",
    "form_response": "{{faira_form.A1_2}}"
  }
}
