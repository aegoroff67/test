{
  "schema_info": {
    "version": "faira.template.v1.0",
    "description": "Complete list of available FAIRA variables for DOCX report templates"
  },
  "organization_info": {
    "org_name": {
      "type": "string",
      "source": "faira_form.A1_1",
      "description": "Organization name"
    },
    "system_name": {
      "type": "string",
      "source": "faira_form.A1_2",
      "description": "AI system name"
    },
    "contact_name": {
      "type": "string",
      "source": "pre_assessment",
      "description": "Assessment contact name"
    },
    "contact_email": {
      "type": "string",
      "source": "pre_assessment",
      "description": "Contact email"
    },
    "assessment_date": {
      "type": "string",
      "source": "assessment",
      "description": "Date of assessment"
    },
    "assessor_name": {
      "type": "string",
      "source": "pre_assessment",
      "description": "Assessor name"
    }
  },
  "risk_scores": {
    "overall_risk_score": {
      "type": "number",
      "range": "0-100",
      "description": "Normalized overall risk score"
    },
    "overall_risk_level": {
      "type": "string",
      "values": [
        "Very Low",
        "Low",
        "Medium",
        "High",
        "Very High"
      ],
      "description": "Risk rating band"
    },
    "raw_risk_score": {
      "type": "number",
      "description": "Raw risk before normalization"
    },
    "total_impact": {
      "type": "number",
      "description": "Total impact score across all questions"
    },
    "total_likelihood": {
      "type": "number",
      "description": "Total likelihood score"
    },
    "total_control_effectiveness": {
      "type": "number",
      "description": "Total control effectiveness score"
    }
  },
  "special_factors": {
    "autonomy_factor": {
      "type": "number",
      "description": "AI autonomy level modifier"
    },
    "data_quality_factor": {
      "type": "number",
      "description": "Data quality modifier"
    },
    "expertise_factor": {
      "type": "number",
      "description": "Expertise availability modifier"
    },
    "autonomy_indicator": {
      "type": "object",
      "description": "Autonomy risk indicator details"
    },
    "sensitive_data_indicator": {
      "type": "object",
      "description": "Sensitive data handling indicator"
    },
    "high_risk_context": {
      "type": "object",
      "description": "High-risk context indicator"
    }
  },
  "domain_scores": {
    "_description": "8 domains from Part B - AI Ethics Principles. Access via domain_scores.Wellbeing.Impact etc.",
    "domains": [
      {
        "id": "B1",
        "short_label": "Wellbeing",
        "full_name": "Human, Societal and Environmental Wellbeing"
      },
      {
        "id": "B2",
        "short_label": "Values",
        "full_name": "Human-Centred Values"
      },
      {
        "id": "B3",
        "short_label": "Fairness",
        "full_name": "Fairness"
      },
      {
        "id": "B4",
        "short_label": "Privacy",
        "full_name": "Privacy Protection and Security"
      },
      {
        "id": "B5",
        "short_label": "Reliability",
        "full_name": "Reliability and Safety"
      },
      {
        "id": "B6",
        "short_label": "Transparency",
        "full_name": "Transparency and Explainability"
      },
      {
        "id": "B7",
        "short_label": "Contestability",
        "full_name": "Contestability"
      },
      {
        "id": "B8",
        "short_label": "Accountability",
        "full_name": "Accountability"
      }
    ],
    "per_domain_variables": {
      "Impact": "Impact score (0-100)",
      "Likelihood": "Likelihood score (0-100)",
      "Control_Effectiveness": "CE score (0-100)",
      "Risk": "Calculated domain risk (0-100)"
    }
  },
  "top_risk_areas": {
    "type": "array",
    "max_items": 3,
    "item_schema": {
      "domain": "Short domain label",
      "fullName": "Full domain name",
      "risk_score": "Numeric risk score (0-100)",
      "concern_level": "Risk level string (Very Low/Low/Medium/High/Very High)"
    },
    "description": "Top 3 highest risk domains sorted by risk_score descending"
  },
  "governance": {
    "governance_score": {
      "type": "number",
      "description": "Governance maturity score"
    },
    "assurance_readiness": {
      "type": "string",
      "values": [
        "High",
        "Medium",
        "Low"
      ],
      "description": "Assurance readiness level"
    },
    "control_coverage_percent": {
      "type": "number",
      "range": "0-100",
      "description": "Percentage of recommended controls addressed"
    }
  },
  "recommended_controls": {
    "type": "array",
    "description": "Prioritized list of recommended controls from Part C",
    "item_schema": {
      "control_id": "Unique identifier (e.g., FAIRA-C-ACC-01)",
      "title": "Control title",
      "description": "Brief description",
      "detailed_description": "Full description",
      "domains": "Array of applicable domain names",
      "priority": "High/Medium/Low",
      "implementation_effort": "Low/Medium/High",
      "implementation_horizon": "Immediate/Short-term/Medium-term/Long-term",
      "evidence_examples": "Array of evidence example strings",
      "rationale": "Why this control is recommended based on assessment"
    }
  },
