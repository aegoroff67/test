  "backend_endpoint": {
    "method": "PUT",
    "url": "/api/assessments/{assessment_id}/system-info",
    "payload": "All form fields as JSON object",
    "notes": [
      "cloudProviderRegion is parsed and split into cloudProvider and cloudRegion before sending",
      "If industry is provided, it updates the organization's primary_industry",
      "If systemName is provided, it updates the assessment name to: {Type}_{SystemName}_In-Progress_{Date}"
    ]
  },
